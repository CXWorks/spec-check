# Copy to .env and fill in. .env is gitignored.
# Then run scripts/make_cluster_secrets.sh to push these into k8s Secrets.
#
# Never `kubectl cp` .env into a pod — the values reach the container through
# Secret references in the pod spec, not as a file.

# Hugging Face token with WRITE access. Pulls Qwen3.5-9B, pushes adapters.
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Destination repo for trained adapters. PRIVATE, and no project-identifying
# words in the name — see docs/gpu-and-runs.md#naming-rules.
HF_CKPT_REPO=your-hf-username/de2-rl-test-ckpt

# Weights & Biases
WANDB_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WANDB_PROJECT=de2-rl-test
WANDB_ENTITY=your-wandb-entity
